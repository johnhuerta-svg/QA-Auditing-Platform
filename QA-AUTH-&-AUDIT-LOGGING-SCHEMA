-- --------------------------------------------------------------------------------
-- 7.6 REPORTING VIEWS: SCORECARDS & HEATMAP TREND ANALYSIS
-- --------------------------------------------------------------------------------

-- View 1: Caseworker Individual Monthly Scorecard
GO
CREATE VIEW vw_Caseworker_MonthlyScorecard AS
SELECT 
    h.CaseworkerUserID,
    u.Username AS CaseworkerName,
    h.UnitID,
    un.UnitName,
    h.DeptID,
    d.DeptName,
    h.AuditYear,
    h.AuditMonth,
    COUNT(h.AuditReviewID) AS TotalAudits,
    AVG(h.FinalScore) AS AverageScore,
    SUM(CASE WHEN ar.IsPass = 1 THEN 1 ELSE 0 END) AS TotalPassed,
    SUM(CASE WHEN ar.IsPass = 0 THEN 1 ELSE 0 END) AS TotalFailed,
    CAST(ROUND((SUM(CASE WHEN ar.IsPass = 1 THEN 1.0 ELSE 0.0 END) / COUNT(h.AuditReviewID)) * 100, 2) AS DECIMAL(5,2)) AS PassRatePercentage
FROM AuditReviewHeader h
JOIN Users u ON h.CaseworkerUserID = u.UserID
JOIN Units un ON h.UnitID = un.UnitID
JOIN Departments d ON h.DeptID = d.DeptID
JOIN AuditReviews ar ON h.AuditReviewID = ar.AuditReviewID
WHERE h.ReviewStage IN ('FINALIZED', 'RELEASED')
GROUP BY h.CaseworkerUserID, u.Username, h.UnitID, un.UnitName, h.DeptID, d.DeptName, h.AuditYear, h.AuditMonth;
GO

-- View 2: Unit-Level Monthly Scorecard
CREATE VIEW vw_Unit_MonthlyScorecard AS
SELECT 
    h.UnitID,
    un.UnitName,
    h.DeptID,
    d.DeptName,
    h.AuditYear,
    h.AuditMonth,
    COUNT(DISTINCT h.CaseworkerUserID) AS ActiveCaseworkersAudited,
    COUNT(h.AuditReviewID) AS TotalUnitAudits,
    AVG(h.FinalScore) AS UnitAverageScore,
    CAST(ROUND((SUM(CASE WHEN ar.IsPass = 1 THEN 1.0 ELSE 0.0 END) / COUNT(h.AuditReviewID)) * 100, 2) AS DECIMAL(5,2)) AS UnitPassRate
FROM AuditReviewHeader h
JOIN Units un ON h.UnitID = un.UnitID
JOIN Departments d ON h.DeptID = d.DeptID
JOIN AuditReviews ar ON h.AuditReviewID = ar.AuditReviewID
WHERE h.ReviewStage IN ('FINALIZED', 'RELEASED')
GROUP BY h.UnitID, un.UnitName, h.DeptID, d.DeptName, h.AuditYear, h.AuditMonth;
GO

-- View 3: Department-Level Monthly Scorecard
CREATE VIEW vw_Department_MonthlyScorecard AS
SELECT 
    h.DeptID,
    d.DeptName,
    h.AuditYear,
    h.AuditMonth,
    COUNT(DISTINCT h.UnitID) AS UnitsAudited,
    COUNT(DISTINCT h.CaseworkerUserID) AS CaseworkersAudited,
    COUNT(h.AuditReviewID) AS TotalDeptAudits,
    AVG(h.FinalScore) AS DeptAverageScore,
    CAST(ROUND((SUM(CASE WHEN ar.IsPass = 1 THEN 1.0 ELSE 0.0 END) / COUNT(h.AuditReviewID)) * 100, 2) AS DECIMAL(5,2)) AS DeptPassRate
FROM AuditReviewHeader h
JOIN Departments d ON h.DeptID = d.DeptID
JOIN AuditReviews ar ON h.AuditReviewID = ar.AuditReviewID
WHERE h.ReviewStage IN ('FINALIZED', 'RELEASED')
GROUP BY h.DeptID, d.DeptName, h.AuditYear, h.AuditMonth;
GO

-- View 4: Error Trend Heatmap Dataset
CREATE VIEW vw_ErrorTrends_HeatmapData AS
SELECT 
    h.DeptID,
    d.DeptName,
    h.UnitID,
    un.UnitName,
    h.CaseworkerUserID,
    u.Username AS CaseworkerName,
    h.AuditYear,
    h.AuditMonth,
    ec.CategoryID,
    ec.CategoryName,
    esc.SubCategoryID,
    esc.SubCategoryName,
    ee.ElementID,
    ee.ElementName,
    COUNT(ed.AuditErrorID) AS ErrorOccurrenceCount,
    SUM(ed.PointsDeducted) AS TotalPointsDeducted
FROM AuditErrorDetails ed
JOIN AuditReviewHeader h ON ed.AuditReviewID = h.AuditReviewID
JOIN ErrorElements ee ON ed.ElementID = ee.ElementID
JOIN ErrorSubCategories esc ON ee.SubCategoryID = esc.SubCategoryID
JOIN ErrorCategories ec ON esc.CategoryID = ec.CategoryID
JOIN Departments d ON h.DeptID = d.DeptID
JOIN Units un ON h.UnitID = un.UnitID
JOIN Users u ON h.CaseworkerUserID = u.UserID
WHERE h.ReviewStage IN ('FINALIZED', 'RELEASED')
GROUP BY h.DeptID, d.DeptName, h.UnitID, un.UnitName, h.CaseworkerUserID, u.Username, h.AuditYear, h.AuditMonth, ec.CategoryID, ec.CategoryName, esc.SubCategoryID, esc.SubCategoryName, ee.ElementID, ee.ElementName;
GO

