-- Procedure 1: Fetch Heatmap Data for Dynamic Web Dashboard
CREATE PROCEDURE sp_GetErrorHeatmap
    @DeptID INT = NULL,
    @UnitID INT = NULL,
    @AuditYear INT = NULL,
    @AuditMonth INT = NULL
AS
BEGIN
    SET NOCOUNT ON;

    SELECT 
        DeptID, DeptName, UnitID, UnitName,
        AuditYear, AuditMonth, CategoryName, SubCategoryName, ElementName,
        SUM(ErrorOccurrenceCount) AS HeatmapValue,
        SUM(TotalPointsDeducted) AS SeverityImpact
    FROM vw_ErrorTrends_HeatmapData
    WHERE (@DeptID IS NULL OR DeptID = @DeptID)
      AND (@UnitID IS NULL OR UnitID = @UnitID)
      AND (@AuditYear IS NULL OR AuditYear = @AuditYear)
      AND (@AuditMonth IS NULL OR AuditMonth = @AuditMonth)
    GROUP BY DeptID, DeptName, UnitID, UnitName, AuditYear, AuditMonth, CategoryName, SubCategoryName, ElementName
    ORDER BY HeatmapValue DESC;
END;
GO

-- Procedure 2: Submit Rebuttal and Trigger Workflow Update
CREATE PROCEDURE sp_SubmitAssociateRebuttal
    @AuditReviewID INT,
    @AuditErrorID INT = NULL,
    @SubmittedByUserID INT,
    @RebuttalReason NVARCHAR(MAX),
    @PolicyJustification NVARCHAR(MAX) = NULL
AS
BEGIN
    SET NOCOUNT ON;
    BEGIN TRANSACTION;

    TRY
        -- 1. Insert Rebuttal Record
        INSERT INTO Rebuttals (AuditReviewID, AuditErrorID, SubmittedByUserID, RebuttalReason, PolicyJustification, Status)
        VALUES (@AuditReviewID, @AuditErrorID, @SubmittedByUserID, @RebuttalReason, @PolicyJustification, 'SUBMITTED');

        -- 2. Update Header Review Stage
        UPDATE AuditReviewHeader
        SET ReviewStage = 'REBUTTAL_PENDING',
            UpdatedAt = GETDATE()
        WHERE AuditReviewID = @AuditReviewID;

        -- 3. Flag Line Item if applicable
        IF @AuditErrorID IS NOT NULL
        BEGIN
            UPDATE AuditErrorDetails
            SET IsRebutted = 1, RebuttalStatus = 'PENDING'
            WHERE AuditErrorID = @AuditErrorID;
        END;

        COMMIT TRANSACTION;
        PRINT 'Rebuttal submitted successfully and stage updated to REBUTTAL_PENDING.';
    CATCH
        ROLLBACK TRANSACTION;
        THROW;
    END CATCH;
END;
GO
