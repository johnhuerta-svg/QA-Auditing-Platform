-- Stored Procedure: Evaluates and handles chronological rebuttal windows
CREATE PROCEDURE sp_SubmitRebuttal
    @AuditReviewID INT,
    @UserComment NVARCHAR(MAX)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @ReleaseDate DATETIME;
    SELECT @ReleaseDate = DateReleased FROM AuditReviews WHERE AuditReviewID = @AuditReviewID;

    -- Enforces strict dispute/rebuttal window
    IF @ReleaseDate IS NULL OR GETDATE() > DATEADD(day, 5, @ReleaseDate)
    BEGIN
        DECLARE @Err NVARCHAR(400);
        SET @Err = CONCAT('Business Rule Violation: The strict dispute/rebuttal window has expired. Release Date: ', 
                          ISNULL(CONVERT(VARCHAR(30), @ReleaseDate, 120), 'Not Yet Released'));
        RAISERROR(@Err, 16, 1);
        RETURN;
    END;

    PRINT 'Rebuttal logged successfully within compliance rules.';
END;
GO

-- Stored Procedure: Validates data state integrity against out-of-band manual overrides
CREATE PROCEDURE sp_VerifyAuditIntegrity
    @AuditReviewID INT,
    @Outcome VARCHAR(20) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @StoredHash VARBINARY(32);
    DECLARE @CalculatedHash VARBINARY(32);
    DECLARE @ReleaseDate DATETIME;

    SELECT 
        @StoredHash = FinalizedHash,
        @ReleaseDate = DateReleased,
        @CalculatedHash = HASHBYTES('SHA2_256', 
            CONCAT(
                CAST(CaseID AS VARCHAR(20)), '|',
                CAST(ISNULL(Cat1_Score, 0) AS VARCHAR(20)), '|',
                CAST(ISNULL(Cat2_Score, 0) AS VARCHAR(20)), '|',
                CAST(ISNULL(Cat3_Score, 0) AS VARCHAR(20)), '|',
                CAST(IsDoubleJeopardyApplied AS VARCHAR(1)), '|',
                ISNULL(CONVERT(VARCHAR(30), DateReleased, 126), 'UNRELEASED')
            )
        )
    FROM AuditReviews 
    WHERE AuditReviewID = @AuditReviewID;

    IF @ReleaseDate IS NULL
        SET @Outcome = 'UNRELEASED';
    ELSE IF @StoredHash = @CalculatedHash
        SET @Outcome = 'VALID';
    ELSE
        SET @Outcome = 'TAMPERED';
END;
GO

-- Stored Procedure: Handles automated statutory retention purging
CREATE PROCEDURE sp_PurgeExpiredData
    @DryRun BIT = 1
AS
BEGIN
    SET NOCOUNT ON;
    
    IF @DryRun = 1
    BEGIN
        SELECT 'PREVIEW RETENTION PURGE', AuditReviewID, CaseID, DataRetentionExpiry 
        FROM AuditReviews 
        WHERE DataRetentionExpiry <= GETDATE() AND IsPurged = 0;
    END;
    ELSE
    BEGIN
        BEGIN TRANSACTION;
        
        -- Performs compliance soft purge to preserve historical system audit trends
        UPDATE AuditReviews
        SET IsPurged = 1,
            Cat1_Score = NULL,
            Cat2_Score = NULL,
            Cat3_Score = NULL
        WHERE DataRetentionExpiry <= GETDATE() AND IsPurged = 0;
        
        COMMIT TRANSACTION;
    END;
END;
GO

