-- ================================================================================
-- SECTION 1: IDENTITY, FEDERATION, & ACCESS CONTROL (IDENTITY PROVIDER)
-- ================================================================================

-- 1. Roles table with AccessLevel tier system mapped to Enterprise App Roles
CREATE TABLE Roles (
    RoleID INT IDENTITY(1,1) PRIMARY KEY,
    RoleName NVARCHAR(50) NOT NULL UNIQUE, -- E.g., 'QA-Caseworker', 'QA-Supervisor'
    AccessLevel INT NOT NULL CONSTRAINT CHK_Roles_AccessLevel CHECK (AccessLevel BETWEEN 1 AND 5),
    PermissionBits INT NOT NULL DEFAULT 0, -- Bitwise evaluation of 15 granular permission bits
    IdentityGroupObjectGUID UNIQUEIDENTIFIER NULL -- Direct mapping to Identity Provider / Entra ID Group Object ID
);

-- 2. Users table federated via Enterprise Identity Provider
CREATE TABLE Users (
    UserID INT IDENTITY(1,1) PRIMARY KEY,
    Username NVARCHAR(100) NOT NULL UNIQUE, -- Primary login string (typically corporate email or ID)
    IdentityUserGUID UNIQUEIDENTIFIER NOT NULL UNIQUE, -- Immutable Subject Identifier (sub/ObjectGUID) passed from OAuth2 token
    RoleID INT NOT NULL CONSTRAINT FK_Users_Roles REFERENCES Roles(RoleID),
    
    -- Personnel Classification Flags
    UserType VARCHAR(20) NOT NULL CONSTRAINT CHK_Users_Type CHECK (UserType IN ('FULL_TIME', 'PART_TIME', 'CONTRACTOR', 'SYSTEM_SERVICE')),
    EmployeeAccountID NVARCHAR(50) NOT NULL UNIQUE, -- Official enterprise tracking identifier
    
    -- Session token lifecycle tracking delegated via OAuth2 JWT validation
    LastTokenRefresh DATETIME NOT NULL DEFAULT GETDATE(),
    ActiveSessionID VARCHAR(255) NULL, -- Corresponds to the 'sid' claim from the ID token
    
    AccountLockedUntil DATETIME NULL, -- Local secondary emergency lock override
    Phone NVARCHAR(20) MASKED WITH (FUNCTION = 'partial(0,"XXX-XXX-",4)') NOT NULL, -- Dynamic Data Masking
    IsActive BIT NOT NULL DEFAULT 1
);

-- ================================================================================
-- SECTION 2: ENTERPRISE AUDIT & COMPLIANCE LOGGING
-- ================================================================================

-- 1. System Audit Log with JSON state capture and session tracking hooks
CREATE TABLE SystemAuditLog (
    AuditID BIGINT IDENTITY(1,1) PRIMARY KEY,
    TableName NVARCHAR(128) NOT NULL,
    RecordID INT NOT NULL,
    ActionType NVARCHAR(20) NOT NULL CONSTRAINT CHK_SystemAuditLog_Action CHECK (ActionType IN ('INSERT','UPDATE','DELETE','SELECT','EXPORT','PRINT','ENTERPRISE_AUTH','BREAK_GLASS')),
    OldValue NVARCHAR(MAX) NULL, -- JSON snapshot before change
    NewValue NVARCHAR(MAX) NULL, -- JSON snapshot after change
    
    -- Data Classification Mapping
    DataSensitivity NVARCHAR(20) NOT NULL CONSTRAINT CHK_SystemAuditLog_Sensitivity CHECK (DataSensitivity IN ('FTI','PHI','MHI','42CFR','PII','STANDARD')),
    RetentionCategory NVARCHAR(50) NOT NULL,
    SAR_Reported BIT NOT NULL DEFAULT 0, -- Safeguard Review reporting flag
    LogDateTime DATETIME NOT NULL DEFAULT GETDATE(),
    
    -- Traceability matrix back to active session context
    PerformedByUserID INT NOT NULL CONSTRAINT FK_SystemAuditLog_Users REFERENCES Users(UserID),
    SessionCorrelationID VARCHAR(255) NULL, 
    ClientIPAddress VARCHAR(45) NOT NULL, -- Captured application client routing IP
    
    -- Automated Persistence Layer mapping statutory archival timelines
    PurgeEligibleDate AS (
        CASE 
            WHEN DataSensitivity IN ('FTI', 'AUDIT', 'SECURITY') THEN DATEADD(year, 7, LogDateTime)
            WHEN DataSensitivity IN ('PHI', 'PII') THEN DATEADD(year, 6, LogDateTime)
            ELSE DATEADD(year, 3, LogDateTime)
        END
    ) PERSISTED
);

-- 2. Sensitive Data Access Log
CREATE TABLE FTI_AccessLog (
    FTILogID BIGINT IDENTITY(1,1) PRIMARY KEY,
    UserID INT NOT NULL CONSTRAINT FK_FTIAccess_Users REFERENCES Users(UserID),
    CaseID INT NOT NULL,
    AccessDateTime DATETIME NOT NULL DEFAULT GETDATE(),
    BusinessJustification NVARCHAR(500) NOT NULL, -- Mandatory plain text reason input tracking
    QueryParametersLogged NVARCHAR(MAX) NOT NULL, -- Serialized parameters parsed by enterprise API
    SessionCorrelationID VARCHAR(255) NULL,
    SAR_Reported BIT NOT NULL DEFAULT 0
);

-- 3. Recipient Data Break-Glass Protocol Engine
CREATE TABLE BreakGlassLog (
    BreakGlassID INT IDENTITY(1,1) PRIMARY KEY,
    UserID INT NOT NULL CONSTRAINT FK_BreakGlass_Users REFERENCES Users(UserID),
    EmergencyJustification NVARCHAR(1000) NOT NULL CONSTRAINT CHK_BreakGlass_Justification CHECK (LEN(EmergencyJustification) >= 1),
    SupervisorNotifiedID INT NOT NULL CONSTRAINT FK_BreakGlass_Supervisor REFERENCES Users(UserID),
    NotificationMethod NVARCHAR(50) NOT NULL DEFAULT 'WEBHOOK',
    EscalatedToCompliance BIT NOT NULL DEFAULT 0,
    Approved BIT NOT NULL DEFAULT 0,
    StartTime DATETIME NOT NULL DEFAULT GETDATE(),
    ReviewDeadline AS (DATEADD(hour, 24, StartTime)) PERSISTED -- Immutable 24-hour review SLA
);

-- 4. Audit Score Modification History
CREATE TABLE AuditScoreHistory (
    HistoryID BIGINT IDENTITY(1,1) PRIMARY KEY,
    AuditReviewID INT NOT NULL,
    FieldChanged NVARCHAR(128) NOT NULL,
    OldValue NVARCHAR(100) NULL,
    NewValue NVARCHAR(100) NULL,
    ChangeReason NVARCHAR(500) NOT NULL,
    IPAddress VARCHAR(45) NOT NULL,
    TokenSessionID VARCHAR(255) NOT NULL,
    ModifiedByUserID INT NOT NULL CONSTRAINT FK_AuditScoreHistory_Users REFERENCES Users(UserID),
    ModifiedDateTime DATETIME NOT NULL DEFAULT GETDATE()
);

-- ================================================================================
-- SECTION 3: CORE QUALITY ASSURANCE REVIEWS & CRYPTOGRAPHIC DATA INTEGRITY
-- ================================================================================

-- 1. Main Quality Assurance Review Table
CREATE TABLE AuditReviews (
    AuditReviewID INT IDENTITY(1,1) PRIMARY KEY,
    CaseID INT NOT NULL, -- Target Case ID
    DateSubmitted DATETIME NOT NULL DEFAULT GETDATE(),
    DateReleased DATETIME NULL, -- Anchor point determining procedural scoring lockdown windows
    
    -- Category Scoring metrics wrapped with strict data layer boundary bounds
    Cat1_Score DECIMAL(5,2) NULL CONSTRAINT CHK_Cat1 CHECK (Cat1_Score BETWEEN 0 AND 100),
    Cat2_Score DECIMAL(5,2) NULL CONSTRAINT CHK_Cat2 CHECK (Cat2_Score BETWEEN 0 AND 100),
    Cat3_Score DECIMAL(5,2) NULL CONSTRAINT CHK_Cat3 CHECK (Cat3_Score BETWEEN 0 AND 100),
    
    -- Math Compute Matrix
    TotalScore AS (ISNULL(Cat1_Score, 0) + ISNULL(Cat2_Score, 0) + ISNULL(Cat3_Score, 0)) PERSISTED,
    IsPass AS (CASE WHEN (ISNULL(Cat1_Score, 0) + ISNULL(Cat2_Score, 0) + ISNULL(Cat3_Score, 0)) >= 96.80 THEN 1 ELSE 0 END) PERSISTED,
    
    -- Double Jeopardy Logic Flags
    IsDoubleJeopardyApplied BIT NOT NULL DEFAULT 0,
    DoubleJeopardyApprovedByID INT NULL CONSTRAINT FK_AuditReviews_DJApproved REFERENCES Users(UserID),
    
    -- Metadata Flags Driving Automated Privacy Routing
    ContainsFTI BIT NOT NULL DEFAULT 0,
    ContainsPHI BIT NOT NULL DEFAULT 0,
    ContainsMHI BIT NOT NULL DEFAULT 0,
    Contains42CFR BIT NOT NULL DEFAULT 0,
    ContainsPII BIT NOT NULL DEFAULT 0,
    
    ClassificationDate DATETIME NULL,
    ClassifiedByID INT NULL CONSTRAINT FK_AuditReviews_ClassifiedBy REFERENCES Users(UserID),
    ClassificationJustification NVARCHAR(500) NULL,
    DataRetentionExpiry DATETIME NULL, -- Field evaluated dynamically via archiving engine
    
    FinalizedHash VARBINARY(32) NULL, -- Houses SHA-256 state tracking signature
    IsPurged BIT NOT NULL DEFAULT 0
);

-- 2. Configuration Management Semantic Versioning Engine
CREATE TABLE SchemaVersionLog (
    VersionID INT IDENTITY(1,1) PRIMARY KEY,
    SemanticVersion VARCHAR(20) NOT NULL, -- E.g., '3.0.0-UNIVERSAL'
    ChangeTicketLinkage VARCHAR(50) NOT NULL, -- Enterprise Change Management ID
    DeployScript NVARCHAR(MAX) NOT NULL,
    RollbackScript NVARCHAR(MAX) NOT NULL,
    ValidationQuery NVARCHAR(MAX) NOT NULL, -- Automated Verification Check
    Environment VARCHAR(10) NOT NULL CONSTRAINT CHK_SchemaVersion_Env CHECK (Environment IN ('DEV','TEST','STAGING','PROD','DR')),
    ExecutionDateTime DATETIME NOT NULL DEFAULT GETDATE(),
    IsRolledBack BIT NOT NULL DEFAULT 0,
    RollbackReason NVARCHAR(500) NULL
);
