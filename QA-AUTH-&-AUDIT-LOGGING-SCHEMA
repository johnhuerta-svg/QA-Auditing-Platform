-- Trigger: Blocks Delete operations on System Logs
CREATE TRIGGER tr_PreventAuditTampering_SystemLog 
ON SystemAuditLog
INSTEAD OF DELETE
AS
BEGIN
    RAISERROR('Enterprise Compliance Mandated Constraint: Physical erasure of active logs is completely blocked.', 16, 1);
    ROLLBACK TRANSACTION;
END;
GO

CREATE TRIGGER tr_PreventAuditTampering_FTILog 
ON FTI_AccessLog
INSTEAD OF DELETE
AS
BEGIN
    RAISERROR('Security Protocol Violation: Sensitive access chains cannot be physically purged.', 16, 1);
    ROLLBACK TRANSACTION;
END;
GO

-- Trigger: Handles Automatic Scoring Lockdown and Generates Cryptographic Signatures
CREATE TRIGGER tr_AuditReviews_ScoringControl
ON AuditReviews
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    -- A: Intercept data mutation requests after evaluation release
    IF EXISTS (
        SELECT 1 
        FROM inserted i
        JOIN deleted d ON i.AuditReviewID = d.AuditReviewID
        WHERE d.DateReleased IS NOT NULL 
          AND (i.Cat1_Score <> d.Cat1_Score OR i.Cat2_Score <> d.Cat2_Score OR i.Cat3_Score <> d.Cat3_Score)
    )
    BEGIN
        -- Cross-verify active context matching using session context
        IF NOT EXISTS (
            SELECT 1 
            FROM BreakGlassLog b
            WHERE b.UserID = (SELECT UserID FROM Users WHERE IdentityUserGUID = TRY_CAST(SESSION_CONTEXT(N'IDENTITY_USER_GUID') AS UNIQUEIDENTIFIER))
              AND b.Approved = 1 
              AND GETDATE() <= b.ReviewDeadline
        )
        BEGIN
            RAISERROR('Quality Control Lockout: Scoring records are immutable post-release unless an authorized Break-Glass instance is initiated.', 16, 1);
            ROLLBACK TRANSACTION;
            RETURN;
        END;
    END;

    -- B: Automate Cryptographic Signature generation upon release
    IF UPDATE(DateReleased) OR UPDATE(Cat1_Score) OR UPDATE(Cat2_Score) OR UPDATE(Cat3_Score) OR UPDATE(IsDoubleJeopardyApplied)
    BEGIN
        UPDATE ar
        SET ar.FinalizedHash = HASHBYTES('SHA2_256', 
            CONCAT(
                CAST(i.CaseID AS VARCHAR(20)), '|',
                CAST(ISNULL(i.Cat1_Score, 0) AS VARCHAR(20)), '|',
                CAST(ISNULL(i.Cat2_Score, 0) AS VARCHAR(20)), '|',
                CAST(ISNULL(i.Cat3_Score, 0) AS VARCHAR(20)), '|',
                CAST(i.IsDoubleJeopardyApplied AS VARCHAR(1)), '|',
                ISNULL(CONVERT(VARCHAR(30), i.DateReleased, 126), 'UNRELEASED')
            )
        )
        FROM AuditReviews ar
        JOIN inserted i ON ar.AuditReviewID = i.AuditReviewID
        WHERE i.DateReleased IS NOT NULL;
    END;
END;
GO

