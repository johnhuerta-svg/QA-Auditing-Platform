Enterprise QA Application Layer Architecture & Code Implementation
1. Database Schema Reference (PostgreSQL / SQL Server)
-- Enums
CREATE TYPE audit_status AS ENUM ('DRAFT', 'SUBMITTED', 'REBUTTAL_PENDING', 'FINALIZED');
CREATE TYPE rebuttal_status AS ENUM ('PENDING', 'ACCEPTED', 'REJECTED');

-- Caseworkers / Auditors
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE NOT NULL,
    role VARCHAR(30) NOT NULL CHECK (role IN ('CASEWORKER', 'AUDITOR', 'SUPERVISOR', 'ADMIN')),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Cases selected for audit
CREATE TABLE cases (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    case_number VARCHAR(50) UNIQUE NOT NULL,
    program_type VARCHAR(50) NOT NULL, -- e.g., 'F&C Medicaid', 'Food & Nutrition'
    caseworker_id UUID NOT NULL REFERENCES users(id),
    sample_month DATE NOT NULL,
    is_blind_sample BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Audit Checkpoint Definitions (Policy Rules & Weights)
CREATE TABLE checklist_rules (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    rule_code VARCHAR(20) NOT NULL, -- e.g., 'POL-20020'
    title VARCHAR(200) NOT NULL,
    category VARCHAR(50) NOT NULL, -- 'Documentation', 'Budgeting', 'Notice Requirements'
    weight NUMERIC(5, 2) NOT NULL, -- e.g., 15.00 points
    is_active BOOLEAN DEFAULT TRUE
);

-- Audits (Master Record)
CREATE TABLE audits (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    case_id UUID NOT NULL REFERENCES cases(id),
    auditor_id UUID NOT NULL REFERENCES users(id),
    status audit_status DEFAULT 'DRAFT',
    total_score NUMERIC(5, 2) DEFAULT 100.00,
    rebuttal_deadline TIMESTAMP WITH TIME ZONE, -- 5-day window from submission
    audited_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Audit Line Items (Scoring breakdown)
CREATE TABLE audit_items (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    audit_id UUID NOT NULL REFERENCES audits(id) ON DELETE CASCADE,
    rule_id UUID NOT NULL REFERENCES checklist_rules(id),
    passed BOOLEAN NOT NULL DEFAULT TRUE,
    points_deducted NUMERIC(5, 2) DEFAULT 0.00,
    findings_notes TEXT,
    policy_citation VARCHAR(100)
);

-- Caseworker Rebuttals / Disputes
CREATE TABLE rebuttals (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    audit_id UUID NOT NULL REFERENCES audits(id),
    audit_item_id UUID NOT NULL REFERENCES audit_items(id),
    caseworker_id UUID NOT NULL REFERENCES users(id),
    rebuttal_text TEXT NOT NULL,
    supervisor_notes TEXT,
    status rebuttal_status DEFAULT 'PENDING',
    submitted_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    resolved_at TIMESTAMP WITH TIME ZONE
);
