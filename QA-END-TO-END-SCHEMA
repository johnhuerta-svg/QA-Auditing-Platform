import React, { useState, useMemo } from 'react';

interface ChecklistRule {
  id: string;
  ruleCode: string;
  title: string;
  category: string;
  weight: number;
}

interface EvaluationState {
  [ruleId: string]: {
    passed: boolean;
    notes: string;
    citation: string;
  };
}

const SAMPLE_RULES: ChecklistRule[] = [
  { id: '1', ruleCode: 'POL-20020', title: 'Returned Mail Protocol & Verification', category: 'Notice Processing', weight: 15.0 },
  { id: '2', ruleCode: 'POL-10040', title: 'Earned Income Budgeting & Paystub Conversion', category: 'Budgeting', weight: 20.0 },
  { id: '3', ruleCode: 'POL-30010', title: 'Timely Disposition Notice Sent Within Window', category: 'Due Process', weight: 10.0 },
  { id: '4', ruleCode: 'POL-40050', title: 'Mandatory Citizenship/Identity Verification Documentation', category: 'Eligibility', weight: 25.0 },
];

export const AuditReviewForm: React.FC<{ caseId: string; auditorId: string }> = ({ caseId, auditorId }) => {
  const [evaluations, setEvaluations] = useState<EvaluationState>(() =>
    SAMPLE_RULES.reduce((acc, rule) => {
      acc[rule.id] = { passed: true, notes: '', citation: '' };
      return acc;
    }, {} as EvaluationState)
  );

  const [submitting, setSubmitting] = useState(false);

  // Real-time weighted score calculation
  const totalScore = useMemo(() => {
    let score = 100;
    SAMPLE_RULES.forEach(rule => {
      if (!evaluations[rule.id]?.passed) {
        score -= rule.weight;
      }
    });
    return Math.max(0, score);
  }, [evaluations]);

  const togglePassed = (ruleId: string) => {
    setEvaluations(prev => ({
      ...prev,
      [ruleId]: { ...prev[ruleId], passed: !prev[ruleId].passed }
    }));
  };

  const updateNotes = (ruleId: string, notes: string) => {
    setEvaluations(prev => ({
      ...prev,
      [ruleId]: { ...prev[ruleId], notes }
    }));
  };

  const handleSubmitAudit = async () => {
    setSubmitting(true);
    const payload = {
      caseId,
      auditorId,
      items: Object.entries(evaluations).map(([ruleId, val]) => ({
        ruleId,
        passed: val.passed,
        findingsNotes: val.notes,
        policyCitation: val.passed ? undefined : SAMPLE_RULES.find(r => r.id === ruleId)?.ruleCode
      }))
    };

    try {
      const res = await fetch('/api/v1/audits', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (res.ok) alert('Audit submitted successfully. 5-day rebuttal window initiated.');
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="max-w-4xl mx-auto p-6 bg-slate-50 min-h-screen text-slate-800">
      <header className="flex justify-between items-center mb-8 border-b pb-4">
        <div>
          <h1 className="text-2xl font-bold tracking-tight">Case QA Evaluation</h1>
          <p className="text-sm text-slate-500">Case ID: {caseId} | Blind Review Protocol</p>
        </div>
        <div className="text-right">
          <span className="text-xs uppercase text-slate-400 font-semibold">Live Weighted Score</span>
          <div className={`text-4xl font-extrabold ${totalScore >= 85 ? 'text-emerald-600' : 'text-amber-600'}`}>
            {totalScore.toFixed(1)}%
          </div>
        </div>
      </header>

      <div className="space-y-4">
        {SAMPLE_RULES.map(rule => {
          const evalItem = evaluations[rule.id];
          return (
            <div key={rule.id} className="bg-white border rounded-lg p-5 shadow-sm">
              <div className="flex justify-between items-start">
                <div>
                  <span className="inline-block px-2 py-0.5 text-xs font-semibold bg-slate-100 text-slate-700 rounded mr-2">
                    {rule.ruleCode}
                  </span>
                  <span className="text-xs text-slate-400 font-medium">{rule.category}</span>
                  <h3 className="text-base font-semibold mt-1">{rule.title}</h3>
                </div>
                <div className="flex items-center space-x-3">
                  <span className="text-xs text-slate-500 font-medium">-{rule.weight} pts</span>
                  <button
                    onClick={() => togglePassed(rule.id)}
                    className={`px-3 py-1.5 rounded-md text-xs font-bold transition-colors ${
                      evalItem.passed
                        ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200'
                        : 'bg-rose-100 text-rose-800 hover:bg-rose-200'
                    }`}
                  >
                    {evalItem.passed ? 'PASSED' : 'DEFICIENCY'}
                  </button>
                </div>
              </div>

              {!evalItem.passed && (
                <div className="mt-4 pt-3 border-t border-slate-100">
                  <label className="block text-xs font-semibold text-slate-600 mb-1">
                    Auditor Findings & Policy Citation Notes
                  </label>
                  <textarea
                    rows={2}
                    className="w-full text-sm border rounded-md p-2 focus:ring-1 focus:ring-slate-400 outline-none"
                    placeholder="Document specific policy deviation..."
                    value={evalItem.notes}
                    onChange={e => updateNotes(rule.id, e.target.value)}
                  />
                </div>
              )}
            </div>
          );
        })}
      </div>

      <div className="mt-8 flex justify-end">
        <button
          onClick={handleSubmitAudit}
          disabled={submitting}
          className="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-sm disabled:opacity-50"
        >
          {submitting ? 'Finalizing...' : 'Submit Audit & Start 5-Day Clock'}
        </button>
      </div>
    </div>
  );
};
src/components/CaseworkerRebuttalPanel.tsx
import React, { useState } from 'react';

interface Props {
  auditId: string;
  auditItemId: string;
  policyCode: string;
  deadline: string; // ISO date string
}

export const CaseworkerRebuttalPanel: React.FC<Props> = ({ auditId, auditItemId, policyCode, deadline }) => {
  const [rebuttalText, setRebuttalText] = useState('');
  const [submitted, setSubmitted] = useState(false);

  const deadlineDate = new Date(deadline);
  const isExpired = new Date() > deadlineDate;

  const handleRebuttalSubmit = async () => {
    const res = await fetch('/api/v1/audits/rebuttal', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        auditId,
        auditItemId,
        rebuttalText
      })
    });
    if (res.ok) setSubmitted(true);
  };

  if (isExpired) {
    return (
      <div className="p-4 bg-rose-50 border border-rose-200 rounded text-rose-800 text-sm">
        The 5-day rebuttal window expired on {deadlineDate.toLocaleDateString()}. Disputed findings can no longer be submitted.
      </div>
    );
  }

  if (submitted) {
    return (
      <div className="p-4 bg-emerald-50 border border-emerald-200 rounded text-emerald-800 text-sm">
        Rebuttal filed successfully. Status updated to <strong>REBUTTAL_PENDING</strong> for supervisor review.
      </div>
    );
  }

  return (
    <div className="bg-white border rounded-lg p-5 mt-4 space-y-3">
      <div className="flex justify-between">
        <h4 className="font-semibold text-sm">Dispute Finding: {policyCode}</h4>
        <span className="text-xs text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
          Window closes: {deadlineDate.toLocaleDateString()}
        </span>
      </div>
      <textarea
        rows={3}
        className="w-full text-sm border rounded p-2 focus:ring-1 focus:ring-blue-500 outline-none"
        placeholder="Provide documentation evidence or manual references to substantiate compliance..."
        value={rebuttalText}
        onChange={e => setRebuttalText(e.target.value)}
      />
      <button
        onClick={handleRebuttalSubmit}
        disabled={!rebuttalText.trim()}
        className="px-4 py-1.5 bg-slate-900 text-white text-xs font-semibold rounded hover:bg-slate-800 disabled:opacity-50"
      >
        Submit Rebuttal for Review
      </button>
    </div>
  );
};
Architectural Highlights
Dynamic Weighted Scoring: Deductions tie directly to the configured weights in checklist_rules, recalculating immediately on the frontend for review transparency and locking down server-side during the transaction.
5-Day Rebuttal Enforcement: The submitAudit routine sets rebuttal_deadline = NOW() + INTERVAL '5 days'. Any submission against POST /api/v1/audits/rebuttal rejects disputes received past this timestamp.
Blind Sampling Support: The cases table tracks is_blind_sample, allowing supervisor/admin portals to mask caseworker identities during active audits to prevent evaluator bias.

