src/services/audit.service.ts
import { Pool } from 'pg';
import { CreateAuditDTO, SubmitRebuttalDTO } from '../types/qa.types';

const pool = new Pool({ connectionString: process.env.DATABASE_URL });

export class AuditService {
  /**
   * Calculates weighted score and establishes the 5-day rebuttal window
   */
  static async submitAudit(data: CreateAuditDTO) {
    const client = await pool.connect();
    try {
      await client.query('BEGIN');

      // 1. Fetch active checklist rules to compute deductions
      const rulesRes = await client.query('SELECT id, weight FROM checklist_rules WHERE is_active = TRUE');
      const ruleWeightMap = new Map<string, number>(
        rulesRes.rows.map(r => [r.id, parseFloat(r.weight)])
      );

      let totalDeductions = 0;
      const calculatedItems = data.items.map(item => {

        const weight = ruleWeightMap.get(item.ruleId) || 0;
|---|weight;
        totalDeductions += deduction;
        return {
          ...item,
          pointsDeducted: deduction
        };
      });

      const finalScore = Math.max(0, 100 - totalDeductions);

      // 2. Set 5-day rebuttal deadline
      const rebuttalDeadline = new Date();
      rebuttalDeadline.setDate(rebuttalDeadline.getDate() + 5);

      // 3. Insert Audit Record
      const auditRes = await client.query(
        `INSERT INTO audits (case_id, auditor_id, status, total_score, rebuttal_deadline, audited_at)
         VALUES ($1, $2, 'SUBMITTED', $3, $4, NOW())
         RETURNING *`,
        [data.caseId, data.auditorId, finalScore, rebuttalDeadline]
      );
      const audit = auditRes.rows[0];

      // 4. Batch insert line items
      for (const item of calculatedItems) {
        await client.query(
          `INSERT INTO audit_items (audit_id, rule_id, passed, points_deducted, findings_notes, policy_citation)
           VALUES ($1, $2, $3, $4, $5, $6)`,
          [audit.id, item.ruleId, item.passed, item.pointsDeducted, item.findingsNotes || null, item.policyCitation || null]
        );
      }

      await client.query('COMMIT');
      return audit;
    } catch (error) {
      await client.query('ROLLBACK');
      throw error;
    } finally {
      client.release();
    }
  }

  /**
   * Submits a rebuttal with strict enforcement of the 5-day deadline
   */
  static async fileRebuttal(dto: SubmitRebuttalDTO) {
    const auditRes = await pool.query(
      'SELECT status, rebuttal_deadline FROM audits WHERE id = $1',
      [dto.auditId]
    );

    if (auditRes.rows.length === 0) {
      throw new Error('Audit record not found');
    }

    const { rebuttal_deadline, status } = auditRes.rows[0];
    const now = new Date();

    if (new Date(rebuttal_deadline) < now) {
      throw new Error('Rebuttal window expired. Submissions must occur within 5 calendar days.');
    }

    if (status === 'FINALIZED') {
      throw new Error('Cannot file a rebuttal against a finalized audit.');
    }

    const result = await pool.query(
      `INSERT INTO rebuttals (audit_id, audit_item_id, caseworker_id, rebuttal_text, status)
       VALUES ($1, $2, $3, $4, 'PENDING')
       RETURNING *`,
      [dto.auditId, dto.auditItemId, dto.caseworkerId, dto.rebuttalText]
    );

    // Update audit status to reflect pending rebuttal
    await pool.query(
      `UPDATE audits SET status = 'REBUTTAL_PENDING' WHERE id = $1`,
      [dto.auditId]
    );

    return result.rows[0];
  }
}
src/controllers/audit.controller.ts
import { Request, Response } from 'express';
import { AuditService } from '../services/audit.service';

export const handleCreateAudit = async (req: Request, res: Response) => {
  try {
    const audit = await AuditService.submitAudit(req.body);
    return res.status(201).json({ success: true, data: audit });
  } catch (err: any) {
    return res.status(400).json({ success: false, message: err.message });
  }
};

export const handleRebuttal = async (req: Request, res: Response) => {
  try {
    const rebuttal = await AuditService.fileRebuttal(req.body);
    return res.status(201).json({ success: true, data: rebuttal });
  } catch (err: any) {
    return res.status(400).json({ success: false, message: err.message });
  }
};
